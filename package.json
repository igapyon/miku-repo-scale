{
  "name": "miku-repo-scale",
  "version": "0.2.4",
  "private": true,
  "description": "Deterministic measurement of repository text, source code, instructions, data, and binary assets.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "miku-repo-scale": "./dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/runtime.mjs"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:bundle": "node scripts/build-release-bundles.mjs",
    "pretest": "npm run build && npm run build:bundle",
    "test": "node --test tests/*.test.mjs",
    "smoke:bundle": "node scripts/check-artifacts.mjs cli",
    "smoke:runtime": "node scripts/check-artifacts.mjs runtime",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "stage:release": "node scripts/stage-release-assets.mjs",
    "check:release": "node scripts/check-artifacts.mjs release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igapyon/miku-repo-scale.git"
  },
  "homepage": "https://github.com/igapyon/miku-repo-scale#readme",
  "bugs": {
    "url": "https://github.com/igapyon/miku-repo-scale/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@willbooster/tree-sitter-bash": "12.0.0",
    "@willbooster/tree-sitter-java": "32.0.1",
    "@willbooster/tree-sitter-javascript": "22.0.1",
    "@willbooster/tree-sitter-python": "16.0.0",
    "@willbooster/tree-sitter-typescript": "26.0.1",
    "@willbooster/web-tree-sitter": "17.0.1",
    "ajv": "8.20.0",
    "esbuild": "0.28.2"
  }
}
