{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/igapyon/miku-repo-scale/schemas/result-v1.schema.json",
  "title": "miku-repo-scale result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "status", "detail", "input", "summary", "by_category", "by_language", "by_extension", "by_role", "source_composition", "diagnostics"],
  "properties": {
    "schema_version": { "const": "miku-repo-scale.result/v1" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "ruleset_version"],
      "properties": { "name": { "const": "miku-repo-scale" }, "version": { "type": "string" }, "ruleset_version": { "type": "string" } }
    },
    "status": { "enum": ["ok", "partial", "error"] },
    "detail": { "enum": ["files", "summary"] },
    "input": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["content_source", "inventory", "include", "exclude", "encoding", "max_file_bytes", "config"],
          "properties": {
            "content_source": { "const": "worktree" },
            "inventory": { "enum": ["tracked", "all"] },
            "include": { "type": "array", "items": { "type": "string" } },
            "exclude": { "type": "array", "items": { "type": "string" } },
            "encoding": { "type": ["string", "null"], "enum": ["utf-8", "utf-16le", "utf-16be", null] },
            "max_file_bytes": { "type": "integer", "minimum": 1 },
            "config": { "$ref": "config-v1.schema.json" }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory", "totals", "coverage", "diagnostic_counts"],
      "properties": {
        "inventory": { "$ref": "#/$defs/inventory" },
        "totals": { "$ref": "#/$defs/aggregate" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "diagnostic_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["total", "error", "warning", "info"],
          "properties": { "total": { "type": "integer", "minimum": 0 }, "error": { "type": "integer", "minimum": 0 }, "warning": { "type": "integer", "minimum": 0 }, "info": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "by_category": {
      "type": "object", "additionalProperties": false,
      "required": ["generated", "test", "source", "documentation", "configuration", "other"],
      "properties": {
        "generated": { "$ref": "#/$defs/aggregate" }, "test": { "$ref": "#/$defs/aggregate" }, "source": { "$ref": "#/$defs/aggregate" },
        "documentation": { "$ref": "#/$defs/aggregate" }, "configuration": { "$ref": "#/$defs/aggregate" }, "other": { "$ref": "#/$defs/aggregate" }
      }
    },
    "by_language": { "$ref": "#/$defs/groupedAggregates" },
    "by_extension": { "$ref": "#/$defs/groupedAggregates" },
    "by_role": {
      "type": "object", "additionalProperties": false,
      "required": ["instruction", "implementation", "definition", "documentation", "data", "unknown"],
      "properties": {
        "instruction": { "$ref": "#/$defs/aggregate" }, "implementation": { "$ref": "#/$defs/aggregate" }, "definition": { "$ref": "#/$defs/aggregate" },
        "documentation": { "$ref": "#/$defs/aggregate" }, "data": { "$ref": "#/$defs/aggregate" }, "unknown": { "$ref": "#/$defs/aggregate" }
      }
    },
    "source_composition": { "$ref": "#/$defs/groupedAggregates" },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "allOf": [
    { "if": { "properties": { "detail": { "const": "files" } } }, "then": { "required": ["files"] } },
    { "if": { "properties": { "detail": { "const": "summary" } } }, "then": { "not": { "required": ["files"] } } }
  ],
  "$defs": {
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "aggregate": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "bytes", "total_physical_lines", "blank_lines", "nonblank_lines", "classified_lines"],
      "properties": {
        "files": { "$ref": "#/$defs/nonNegativeInteger" }, "bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "total_physical_lines": { "$ref": "#/$defs/nonNegativeInteger" }, "blank_lines": { "$ref": "#/$defs/nonNegativeInteger" }, "nonblank_lines": { "$ref": "#/$defs/nonNegativeInteger" },
        "classified_lines": { "oneOf": [{ "$ref": "#/$defs/classifiedAggregate" }, { "type": "null" }] }
      }
    },
    "classifiedAggregate": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "bytes", "total_physical_lines", "blank_lines", "nonblank_lines", "comment_only_lines", "code_lines", "mixed_code_comment_lines", "lines_with_comments"],
      "properties": {
        "files": { "$ref": "#/$defs/nonNegativeInteger" }, "bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "total_physical_lines": { "$ref": "#/$defs/nonNegativeInteger" }, "blank_lines": { "$ref": "#/$defs/nonNegativeInteger" },
        "nonblank_lines": { "$ref": "#/$defs/nonNegativeInteger" }, "comment_only_lines": { "$ref": "#/$defs/nonNegativeInteger" },
        "code_lines": { "$ref": "#/$defs/nonNegativeInteger" }, "mixed_code_comment_lines": { "$ref": "#/$defs/nonNegativeInteger" },
        "lines_with_comments": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "groupedAggregates": { "type": "object", "additionalProperties": { "$ref": "#/$defs/aggregate" } },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["included_regular_files", "bytes_measured_files", "text_measured_files", "lexically_classified_files", "basic_only_files", "binary_files", "unmeasured_files"],
      "properties": {
        "included_regular_files": { "$ref": "#/$defs/nonNegativeInteger" }, "bytes_measured_files": { "$ref": "#/$defs/nonNegativeInteger" },
        "text_measured_files": { "$ref": "#/$defs/nonNegativeInteger" }, "lexically_classified_files": { "$ref": "#/$defs/nonNegativeInteger" },
        "basic_only_files": { "$ref": "#/$defs/nonNegativeInteger" }, "binary_files": { "$ref": "#/$defs/nonNegativeInteger" }, "unmeasured_files": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["tracked_entries", "excluded_entries", "included_entries", "metadata_only_entries", "ignored_metadata_only_entries"],
      "properties": {
        "tracked_entries": { "$ref": "#/$defs/nonNegativeInteger" }, "excluded_entries": { "$ref": "#/$defs/nonNegativeInteger" },
        "included_entries": {
          "type": "object", "additionalProperties": false, "required": ["regular", "symlink", "gitlink", "unresolved"],
          "properties": { "regular": { "$ref": "#/$defs/nonNegativeInteger" }, "symlink": { "$ref": "#/$defs/nonNegativeInteger" }, "gitlink": { "$ref": "#/$defs/nonNegativeInteger" }, "unresolved": { "$ref": "#/$defs/nonNegativeInteger" } }
        },
        "metadata_only_entries": { "$ref": "#/$defs/nonNegativeInteger" }, "ignored_metadata_only_entries": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "ignoreRule": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["source_kind", "source", "line", "pattern"],
          "properties": {
            "source_kind": { "enum": ["root_gitignore", "nested_gitignore", "info_exclude", "global"] },
            "source": { "type": ["string", "null"] }, "line": { "type": "integer", "minimum": 1 }, "pattern": { "type": "string" }
          }
        }
      ]
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["bytes", "observed_bytes", "total_physical_lines", "blank_lines", "nonblank_lines", "comment_only_lines", "code_lines", "mixed_code_comment_lines", "lines_with_comments"],
      "properties": {
        "bytes": { "type": ["integer", "null"], "minimum": 0 }, "observed_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "total_physical_lines": { "type": ["integer", "null"], "minimum": 0 }, "blank_lines": { "type": ["integer", "null"], "minimum": 0 },
        "nonblank_lines": { "type": ["integer", "null"], "minimum": 0 }, "comment_only_lines": { "type": ["integer", "null"], "minimum": 0 },
        "code_lines": { "type": ["integer", "null"], "minimum": 0 }, "mixed_code_comment_lines": { "type": ["integer", "null"], "minimum": 0 },
        "lines_with_comments": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "name", "extension", "size_bytes", "git", "kind", "stages", "language", "language_reason", "role", "role_reason", "category", "category_reason", "measurement", "skip_reason", "comment_analysis", "metrics"],
      "properties": {
        "path": { "type": ["string", "null"] }, "path_bytes_base64": { "type": "string" }, "name": { "type": ["string", "null"] }, "extension": { "type": ["string", "null"] },
        "size_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "git": {
          "type": "object", "additionalProperties": false, "required": ["tracked", "ignore"],
          "properties": {
            "tracked": { "type": "boolean" },
            "ignore": {
              "type": "object", "additionalProperties": false, "required": ["would_ignore", "rule"],
              "properties": { "would_ignore": { "type": ["boolean", "null"] }, "rule": { "$ref": "#/$defs/ignoreRule" } }
            }
          }
        },
        "kind": { "enum": ["regular", "symlink", "gitlink", "unresolved"] }, "stages": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 3 } },
        "language": { "type": "string" }, "language_reason": { "type": "string" }, "role": { "enum": ["instruction", "implementation", "definition", "documentation", "data", "unknown"] }, "role_reason": { "type": "string" },
        "category": { "enum": ["generated", "test", "source", "documentation", "configuration", "other"] }, "category_reason": { "type": "string" },
        "measurement": { "enum": ["lexical", "basic", "binary", "excluded", "skipped", "error"] }, "skip_reason": { "type": ["string", "null"] },
        "comment_analysis": { "enum": ["not_requested", "unsupported", "available", "error"] }, "binary_type": { "type": "string" }, "metrics": { "$ref": "#/$defs/metrics" }
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false, "required": ["code", "severity", "path", "details"],
      "properties": { "code": { "type": "string" }, "severity": { "enum": ["error", "warning", "info"] }, "path": { "type": ["string", "null"] }, "details": { "type": "object" } }
    }
  }
}
